# handsfree-code configuration.
# Copy to ~/.config/handsfree-code/config.env and run: chmod 600 ~/.config/handsfree-code/config.env
# Never commit the real file. All settings are optional.

# Natural voice and ~1 s transcription. Without it: macOS voice + local Whisper.
OPENAI_API_KEY=

# Optional: an ElevenLabs voice instead of OpenAI's (transcription stays on OpenAI).
# ELEVENLABS_API_KEY=
# HANDSFREE_ELEVENLABS_VOICE=

# Wake word and spellings the transcription may produce for it.
# HANDSFREE_NAME=James
# HANDSFREE_NAME_SPELLINGS=djeims,jeimes

# Voice. Male: echo, ash, verse, onyx. Female: coral, nova, shimmer.
# HANDSFREE_OPENAI_VOICE=echo
# HANDSFREE_SPEED=1.4
# HANDSFREE_ACCENT=brasileiro neutro, sem nenhuma marca regional
# HANDSFREE_MAC_VOICE=Eddy

# Audio devices and echo.
# HANDSFREE_MIC=AirPods
# HANDSFREE_ECHO_TAIL_MS=1000

# Local transcription fallback.
# HANDSFREE_LOCAL_STT_MODEL=small
# HANDSFREE_PYTHON=~/.handsfree-code/venv/bin/python
